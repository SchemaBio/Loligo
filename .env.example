# Loligo standalone development configuration.
# ZhiJi oncology initial baseline. Inherited germline workflow profiles,
# schemas, and business behavior stay in place.
# Self-hosted production deployments use deploy/.env.example and deploy/deploy.sh.
# SaaS production values are generated by Onykia/deploy.
# The server does not load this file automatically. Export the variables before
# go run ./cmd/server.
# Create the database first, for example:
#   CREATE ROLE loligo LOGIN PASSWORD 'loligo';
#   CREATE DATABASE loligo OWNER loligo;
# This example uses local PostgreSQL on port 5432. deploy/docker-compose.yml
# publishes its PostgreSQL on 127.0.0.1:54322 instead.
# Sepiida is an external shared service. Leave SEPIIDA_ENABLED=false for
# standalone development. Set SEPIIDA_ENABLED=true only with the existing
# service SEPIIDA_URL and SEPIIDA_QUERY_KEY. Do not generate those secrets.

SERVER_PORT=8082
GIN_MODE=debug
ALLOW_INSECURE_DEV=true
CORS_ALLOWED_ORIGINS=http://localhost:3002
# Comma-separated reverse-proxy IPs/CIDRs. Keep empty when Loligo is exposed directly.
TRUSTED_PROXIES=
DB_DSN=host=localhost user=loligo password=loligo dbname=loligo port=5432 sslmode=disable TimeZone=Asia/Shanghai

OUTPUT_DIR=/mnt/data/output
TEMPLATE_DIR=/mnt/data/templates
ARCHIVE_DIR=/mnt/data/archive
STORAGE_LOCAL_DIR=/mnt/data/uploads
DEFAULT_EXECUTOR=local
MINIWDL_PATH=miniwdl

SEPIIDA_ENABLED=false
SEPIIDA_URL=
SEPIIDA_QUERY_KEY=
PARQUET_ENABLED=false

JWT_SECRET=change-me-to-a-long-random-string
JWT_COOKIE_SECURE=false
CREATE_DEFAULT_ADMIN=false
CVM_CALLBACK_SECRET=
DEFAULT_ADMIN_EMAIL=admin@loligo.local
DEFAULT_ADMIN_PASSWORD=change-me-before-use

# Optional OpenAI-compatible proxy.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o

# CNV AI evidence delivery billing; independent of formal rule approval.
AI_ASSISTANCE_CNV_BILLING_ENABLED=false
