# SchemaBio self-hosted deployment
# Copy to .env. PUBLIC_ORIGIN is the only required setting.
# Values use Bash .env syntax because deploy.sh loads this file directly.
# Sepiida is an existing external shared service. This deployment does not
# create a Sepiida server, agent, database, or signing keys. Leave
# SEPIIDA_ENABLED=false unless SEPIIDA_URL and SEPIIDA_QUERY_KEY are supplied
# by that external service. Workflows that need an agent must use an
# externally managed agent; install does not start one.

PUBLIC_ORIGIN=https://schemabio.example.com
# Optional authenticated reference Range endpoint; empty uses static IGV URLs.
# Self-hosted: https://your-loligo-host/api/v1
IGV_REFERENCE_PROXY_BASE_URL=

# Usually no changes are needed below this line.
WORKFLOW_HOST_DIR=./workflows
MINIWDL_PATH=
INSTALL_ROOT=/opt/zhiji
DATA_ROOT=/var/lib/zhiji
DEFAULT_ADMIN_EMAIL=admin@schemabio.local
SUPPORT_EMAIL=support@schemabio.com

POSTGRES_PORT=54322
LOLIGO_PORT=8082
# ZhiJi container listens on 3000; this host port is published to the browser.
ZHIJI_PORT=3002
# Default UI language: zh-CN, zh-Hant, en, es-419.
ZHIJI_DEFAULT_LOCALE=zh-CN

# External shared Sepiida. Do not generate replacement secrets here.
SEPIIDA_ENABLED=false
SEPIIDA_URL=
SEPIIDA_QUERY_KEY=

ARCHIVE_CLEANUP=false
UPLOAD_MAX_SIZE_MB=0
DATA_RETENTION_DAYS=0
PARQUET_ENABLED=true
